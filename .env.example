# =====================================================================
# Smart Campus Assistant — Environment Variables Template
# =====================================================================
# Copy this file to `.env` and fill in your real values:
#
#     cp .env.example .env
#
# Then edit .env with:
#   - your MySQL username / password
#   - your Gmail address and a 16-character Gmail App Password
#   - a randomly generated JWT secret
#
# The `.env` file is gitignored and must NEVER be committed.
#
# How to load .env when running the backend (pick ONE):
#
#   1. IntelliJ EnvFile plugin
#      - Settings > Plugins > install "EnvFile"
#      - Settings > Tools > EnvFile > add `.env`
#      - In your run config, enable "EnvFile" and select .env
#
#   2. spring-dotenv library (add to pom.xml — reads .env automatically)
#        <dependency>
#            <groupId>me.paulschwarz</groupId>
#            <artifactId>spring-dotenv</artifactId>
#            <version>4.0.0</version>
#        </dependency>
#
#   3. Run from terminal with the env vars exported:
#        Git Bash / WSL / macOS / Linux:
#            env $(cat .env | xargs) mvn spring-boot:run
#        PowerShell:
#            Get-Content .env | ForEach-Object {
#                if ($_ -match '^\s*([^#][^=]+?)\s*=\s*(.*)$') {
#                    [Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process")
#                }
#            }
#            mvn spring-boot:run
# =====================================================================


# ===============================
# MySQL Database
# ===============================
# The Spring Boot app connects using these credentials.
# Default user is usually `root`. Password is whatever you set when
# installing MySQL. If you never set one, leave DB_PASSWORD empty.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here


# ===============================
# Spring Mail — Gmail SMTP
# ===============================
# MAIL_USERNAME: the full Gmail address the app sends OTP emails from.
# MAIL_PASSWORD: a 16-character App Password — NOT your normal Gmail
#                password. Create one at:
#                https://myaccount.google.com/apppasswords
#
# Prerequisites:
#   1. Enable 2-Step Verification on the Google account.
#   2. Generate an App Password for "Mail".
#   3. Paste the 16-character code (no spaces) below.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password


# ===============================
# JWT Secret
# ===============================
# Long random Base64 string. Used to sign and verify JWT tokens.
# Generate a fresh one with:
#
#     openssl rand -base64 64
#
# Rotating this value invalidates all existing tokens — every
# logged-in user will need to log in again.
JWT_SECRET=your_base64_secret_here


# ===============================
# Gemini API (Optional)
# ===============================
# Only needed if you plan to enable the AI chat assistant feature.
# Leave blank if you're not using it — the app will start without it.
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here